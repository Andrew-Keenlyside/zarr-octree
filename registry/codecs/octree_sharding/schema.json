{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": { "const": "octree_sharding" },
    "configuration": {
      "type": "object",
      "properties": {
        "chunk_shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1
        },
        "codecs": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "configuration": { "type": "object" }
                },
                "required": ["name"]
              }
            ]
          }
        },
        "layout": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "name": { "const": "octree" },
                "configuration": {
                  "type": "object",
                  "properties": {
                    "target": { "type": "number", "exclusiveMinimum": 0 },
                    "unit": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["name"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": { "const": "runs" },
                "configuration": {
                  "type": "object",
                  "properties": {
                    "min_weight": { "type": "number", "minimum": 0 },
                    "max_weight": { "type": "number", "exclusiveMinimum": 0 },
                    "unit": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["chunk_shape", "codecs"],
      "additionalProperties": false
    }
  },
  "required": ["name", "configuration"],
  "additionalProperties": false
}
